# ===============================================
# CONFIGURACIÓN DEL CLIENTE FRONTEND (OPENMUN)
# ===============================================

# URL del servidor Socket.io / WebSocket para sincronización en tiempo real
# Por defecto se conecta a la API comunitaria oficial
VITE_SOCKET_SERVER_URL=https://api.openmun.app

# URL base para la API REST de conferencias (si difiere del servidor de sockets)
VITE_API_BASE_URL=https://api.openmun.app

# Dominio público para enlaces compartibles y códigos QR
# Configúralo con tu dominio público para evitar mostrar IPs locales en pantallas o proyectores
VITE_PUBLIC_APP_URL=https://openmun.org

# Google OAuth 2.0 Client ID para respaldos en Google Drive (Google Identity Services)
# Genera tus propias credenciales en Google Cloud Console si deseas alojar tu instancia
VITE_GOOGLE_CLIENT_ID=917213180364-2jktmr4s9etrajiai697bfk8410u424r.apps.googleusercontent.com
