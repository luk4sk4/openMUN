# ===============================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (OPENMUN)
# ===============================================

# Puerto y host del servidor Express / Socket.io
PORT=3000
HOST=0.0.0.0

# Node.js >=22.13. Ruta absoluta al SQLite existente en despliegues con datos.
# Si se omite, se utiliza backend/openmun.sqlite.
DATABASE_PATH=
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Mantener estable entre reinicios para conservar sesiones firmadas.
SESSION_SECRET=
ALLOWED_ORIGINS=https://openmun.app,http://localhost:5173,http://localhost:4173
SUPABASE_KEEPALIVE_ENABLED=true

# Configuración SMTP para envío automático de respaldos de conferencias
# Proveedor recomendado: Proton Mail Bridge, Gmail, SendGrid, etc.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@ejemplo.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="OpenMUN" <tu_correo@ejemplo.com>

# Panel de control de Socket.io (@socket.io/admin-ui)
# Opcional: Genera un hash bcrypt si deseas habilitar el panel de administración
SOCKET_ADMIN_USER=admin
SOCKET_ADMIN_PASSWORD_HASH=

# Configuración Supabase Keep-Alive (previene pausa por inactividad de 7 días)
SUPABASE_URL=https://przhpubwzwgulaoprnda.supabase.co
SUPABASE_ANON_KEY=sb_publishable_tu_anon_key_aqui
SUPABASE_PING_INTERVAL_HOURS=24
